@@ -0,0 +1,81 @@
+from __future__ import annotations
+
+from starlette.datastructures import Headers
+from starlette.responses import PlainTextResponse
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+SCOPE_KEY = "starlette.body_limit"
+
+
+class RequestBodyLimitExceeded(Exception):
+    """Raised from `receive` when the request body exceeds the configured limit."""
+
+
+class _LimitState:
+    def __init__(self, limit: int) -> None:
+        self.limit = limit
+        self.received = 0
+        self.response_started = False
+        self.rejected = False
+
+
+class RequestBodyLimitMiddleware:
+    def __init__(self, app: ASGIApp, max_body_size: int) -> None:
+        self.app = app
+        self.max_body_size = max_body_size
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        state: _LimitState | None = scope.get(SCOPE_KEY)
+        if state is not None:
+            # A limit is already being enforced by an outer instance: override it
+            # instead of counting the body twice.
+            state.limit = self.max_body_size
+            if self._declared_too_large(scope):
+                await self._reject(state, scope, receive, send)
+                return
+            await self.app(scope, receive, send)
+            return
+
+        state = _LimitState(self.max_body_size)
+        scope[SCOPE_KEY] = state
+
+        async def tracked_send(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                state.response_started = True
+            await send(message)
+
+        async def limited_receive() -> Message:
+            message = await receive()
+            if message["type"] == "http.request":
+                state.received += len(message.get("body", b""))
+                if state.received > state.limit:
+                    await self._reject(state, scope, receive, tracked_send)
+                    raise RequestBodyLimitExceeded()
+            return message
+
+        if self._declared_too_large(scope):
+            await self._reject(state, scope, receive, tracked_send)
+            return
+
+        try:
+            await self.app(scope, limited_receive, tracked_send)
+        except RequestBodyLimitExceeded:
+            if not state.rejected:
+                raise
+
+    def _declared_too_large(self, scope: Scope) -> bool:
+        content_length = Headers(scope=scope).get("content-length")
+        if content_length is None or not content_length.isdigit():
+            return False
+        return int(content_length) > scope[SCOPE_KEY].limit
+
+    async def _reject(self, state: _LimitState, scope: Scope, receive: Receive, send: Send) -> None:
+        if state.response_started:
+            return
+        state.rejected = True
+        response = PlainTextResponse("Content Too Large", status_code=413)
+        await response(scope, receive, send)
diff --git a/tests/middleware/test_body_limit.py b/tests/middleware/test_body_limit.py
new file mode 100644
index 0000000..d9ae9a2
--- /dev/null
+++ b/tests/middleware/test_body_limit.py
@@ -0,0 +1,193 @@
+from __future__ import annotations
+
+from collections.abc import Iterator
+from typing import Any
+
+import pytest
+
+import starlette
+from starlette.middleware.body_limit import RequestBodyLimitExceeded, RequestBodyLimitMiddleware
+from starlette.requests import Request
+from starlette.responses import PlainTextResponse
+from starlette.types import Message, Receive, Scope, Send
+from tests.types import TestClientFactory
+
+
+async def read_all(scope: Scope, receive: Receive, send: Send) -> None:
+    request = Request(scope, receive)
+    total = 0
+    async for chunk in request.stream():
+        total += len(chunk)
+    await PlainTextResponse(f"read {total}")(scope, receive, send)
+
+
+async def read_form(scope: Scope, receive: Receive, send: Send) -> None:
+    request = Request(scope, receive)
+    async with request.form() as form:
+        names = ",".join(form.keys())
+    await PlainTextResponse(f"form {names}")(scope, receive, send)
+
+
+def test_not_exported_from_package_root() -> None:
+    assert not hasattr(starlette, "RequestBodyLimitMiddleware")
+
+
+def test_body_over_limit(test_client_factory: TestClientFactory) -> None:
+    client = test_client_factory(RequestBodyLimitMiddleware(read_all, max_body_size=10))
+    response = client.post("/", content=b"x" * 11)
+    assert response.status_code == 413
+    assert response.text == "Content Too Large"
+    assert response.headers["content-type"].startswith("text/plain")
+
+
+def test_body_exactly_at_limit(test_client_factory: TestClientFactory) -> None:
+    client = test_client_factory(RequestBodyLimitMiddleware(read_all, max_body_size=10))
+    response = client.post("/", content=b"x" * 10)
+    assert response.status_code == 200
+    assert response.text == "read 10"
+
+
+def test_streaming_body_without_content_length(test_client_factory: TestClientFactory) -> None:
+    def gen(sizes: list[int]) -> Iterator[bytes]:
+        for size in sizes:
+            yield b"x" * size
+
+    client = test_client_factory(RequestBodyLimitMiddleware(read_all, max_body_size=10))
+    ok = client.post("/", content=gen([5, 5]))
+    assert ok.status_code == 200
+    assert ok.text == "read 10"
+    too_big = client.post("/", content=gen([5, 3, 3]))
+    assert too_big.status_code == 413
+
+
+def test_multipart_counts_encoding_overhead(test_client_factory: TestClientFactory) -> None:
+    client = test_client_factory(RequestBodyLimitMiddleware(read_form, max_body_size=100))
+    # The file data alone is exactly the limit, but boundaries and headers push it over.
+    response = client.post("/", files={"file": ("a.txt", b"x" * 100)})
+    assert response.status_code == 413
+
+    client = test_client_factory(RequestBodyLimitMiddleware(read_form, max_body_size=10_000))
+    response = client.post("/", files={"file": ("a.txt", b"x" * 100)})
+    assert response.status_code == 200
+    assert response.text == "form file"
+
+
+def scope_with_headers(headers: list[tuple[bytes, bytes]]) -> Scope:
+    return {"type": "http", "method": "POST", "path": "/", "headers": headers}
+
+
+async def run(app: Any, scope: Scope, bodies: list[bytes]) -> list[Message]:
+    pending = list(bodies)
+    sent: list[Message] = []
+
+    async def receive() -> Message:
+        if pending:
+            body = pending.pop(0)
+            return {"type": "http.request", "body": body, "more_body": bool(pending)}
+        return {"type": "http.disconnect"}
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    await app(scope, receive, send)
+    return sent
+
+
+@pytest.mark.anyio
+async def test_declared_content_length_rejected_before_reading() -> None:
+    called = False
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        nonlocal called
+        called = True  # pragma: no cover
+
+    middleware = RequestBodyLimitMiddleware(app, max_body_size=10)
+    sent = await run(middleware, scope_with_headers([(b"content-length", b"11")]), [b"x" * 11])
+    assert not called
+    assert sent[0]["status"] == 413
+
+
+@pytest.mark.anyio
+async def test_understated_content_length_does_not_bypass() -> None:
+    middleware = RequestBodyLimitMiddleware(read_all, max_body_size=10)
+    sent = await run(middleware, scope_with_headers([(b"content-length", b"1")]), [b"x" * 6, b"x" * 6])
+    assert [m["status"] for m in sent if m["type"] == "http.response.start"] == [413]
+
+
+@pytest.mark.anyio
+async def test_invalid_content_length_is_ignored() -> None:
+    middleware = RequestBodyLimitMiddleware(read_all, max_body_size=10)
+    sent = await run(middleware, scope_with_headers([(b"content-length", b"abc")]), [b"x" * 10])
+    assert sent[0]["status"] == 200
+
+
+@pytest.mark.anyio
+async def test_non_http_scope_passes_through() -> None:
+    seen: list[str] = []
+
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        seen.append(scope["type"])
+
+    middleware = RequestBodyLimitMiddleware(app, max_body_size=1)
+    await run(middleware, {"type": "websocket"}, [])
+    assert seen == ["websocket"]
+
+
+@pytest.mark.anyio
+async def test_non_request_messages_are_not_counted() -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        message = await receive()
+        assert message["type"] == "http.disconnect"
+        await PlainTextResponse("ok")(scope, receive, send)
+
+    middleware = RequestBodyLimitMiddleware(app, max_body_size=1)
+    sent = await run(middleware, scope_with_headers([]), [])
+    assert sent[0]["status"] == 200
+
+
+@pytest.mark.anyio
+async def test_no_second_response_when_response_already_started() -> None:
+    async def app(scope: Scope, receive: Receive, send: Send) -> None:
+        await send({"type": "http.response.start", "status": 200, "headers": []})
+        while True:
+            await receive()
+
+    middleware = RequestBodyLimitMiddleware(app, max_body_size=10)
+    sent: list[Message] = []
+    pending = [b"x" * 6, b"x" * 6]
+
+    async def receive() -> Message:
+        body = pending.pop(0)
+        return {"type": "http.request", "body": body, "more_body": bool(pending)}
+
+    async def send(message: Message) -> None:
+        sent.append(message)
+
+    with pytest.raises(RequestBodyLimitExceeded):
+        await middleware(scope_with_headers([]), receive, send)
+    assert [m["type"] for m in sent] == ["http.response.start"]
+    assert sent[0]["status"] == 200
+
+
+@pytest.mark.anyio
+async def test_nested_limit_can_raise_outer_limit() -> None:
+    inner = RequestBodyLimitMiddleware(read_all, max_body_size=100)
+    outer = RequestBodyLimitMiddleware(inner, max_body_size=10)
+    sent = await run(outer, scope_with_headers([]), [b"x" * 50])
+    assert sent[0]["status"] == 200
+
+
+@pytest.mark.anyio
+async def test_nested_limit_can_lower_outer_limit() -> None:
+    inner = RequestBodyLimitMiddleware(read_all, max_body_size=5)
+    outer = RequestBodyLimitMiddleware(inner, max_body_size=100)
+    sent = await run(outer, scope_with_headers([]), [b"x" * 6])
+    assert sent[0]["status"] == 413
+
+
+@pytest.mark.anyio
+async def test_nested_limit_rejects_declared_content_length() -> None:
+    inner = RequestBodyLimitMiddleware(read_all, max_body_size=5)
+    outer = RequestBodyLimitMiddleware(inner, max_body_size=100)
+    sent = await run(outer, scope_with_headers([(b"content-length", b"6")]), [b"x" * 6])
+    assert [m["status"] for m in sent if m["type"] == "http.response.start"] == [413]
