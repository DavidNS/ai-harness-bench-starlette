{"advisories": [{"file": "starlette/middleware/body_limit.py", "line": 47, "pass": 2, "severity": "advisory", "text": "`str.isdigit()` is true for characters like '\u00b2' that `int()` rejects, so a crafted Content-Length header raises ValueError (a 500); no test covers it, and `isascii() and isdigit()` would avoid it."}, {"file": "tests/middleware/test_body_limit.py", "line": 0, "pass": 2, "severity": "advisory", "text": "No test checks that the scope key and state key are restored or removed when the app raises (the `finally` path)."}, {"file": "starlette/middleware/body_limit.py", "line": 88, "pass": 4, "severity": "advisory", "text": "`_reject` is a one-line wrapper used twice and could be inlined."}], "at": "2026-10-13T18:56:29+00:00", "attempt": 1, "event": "GateEvaluated", "failures": [], "gate": "review.approved", "passed": true, "run_id": "20261013T185232Z-a28b32", "schema_version": 1, "task": "T1", "verdict": "approve"}
